# Скопіювати у ~/.shopper/api.env (на сервері — data/api.env) і заповнити. chmod 600.

TELEGRAM_BOT_TOKEN=
# Лише для першого запуску: ці id стануть адмінами, далі доступ
# роздається з бота і лежить у доступ.json
TELEGRAM_ALLOWED_IDS=395687418
# Куди слати готові звіти (id групи, від'ємний). Порожньо — кожному адміну особисто.
REPORT_CHAT_ID=

